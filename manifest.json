{
  "manifest_version": 3,
  "name": "X 推荐检查器",
  "version": "0.1.2",
  "description": "检查你的账号和帖子是否被推荐算法标记。",
  "action": {
    "default_title": "X 推荐检查器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/i/under_the_hood*"],
      "js": ["capture-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/i/under_the_hood*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
